# LilyGo T-SIM7600 (ESP32-WROVER-E N16R8)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 16 MB layout with OTA slots
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# PPP over the modem UART
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
# esp_modem uses C++ exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y
# TLS: trust only ISRG Root X1 + X2 (rmx.lt's Let's Encrypt chain), not the
# whole Mozilla bundle: a CA whose keys leak (eMudhra/emSign, Oct 2026) could
# otherwise issue a fake mqtt.rmx.lt / api.rmx.lt that the device accepts.
# Path is relative to the project directory.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/rmx-ca-bundle.pem"
# Large buffers (MQTT list responses) go to PSRAM
CONFIG_SPIRAM_USE_MALLOC=y
# OTA: a new image boots as "pending verify" and the bootloader rolls back
# if it resets before confirming itself (main/ota.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# OTA images must be signed (RSA-3072, Secure Boot V2 scheme) and are checked
# before the update slot becomes the boot slot. No Secure Boot: no eFuses are
# burned and USB flashing works as before. The key never goes in the repo.
CONFIG_ESP32_REV_MIN_3=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/ota_signing_key.pem"
